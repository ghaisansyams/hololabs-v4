# Base URL used for SEO metadata, sitemap, and canonical links.
# Leave unset locally; set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=https://marketing-halomoc.vercel.app

# Shared database (Neon Postgres). REQUIRED — without it, booking, payment
# and check-in cannot work: there is no other place for one visitor's
# browser to become visible to anyone else, including the admin.
#
# This is a plain Postgres connection string, not a public/anon key — it is
# only ever read server-side (Server Components / Server Actions, see
# src/lib/db/client.ts), never shipped to the browser. Get it from the Neon
# console (Project → Connection Details → "Pooled connection" recommended
# for serverless). Run db/schema.sql once against this database (Neon's SQL
# Editor, or `psql "$DATABASE_URL" -f db/schema.sql`) before setting this.
DATABASE_URL=
