# Base URL used for SEO metadata, sitemap, and canonical links.
# Leave unset locally; set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Shared database. REQUIRED — without it, booking, payment and check-in
# cannot work: there is no other place for one visitor's browser to become
# visible to anyone else, including the admin.
#
# A plain Postgres connection string — local Postgres for development, your
# production server for deployment. It is only ever read server-side
# (Server Components / Server Actions, see src/lib/db/client.ts), never
# shipped to the browser. Run db/schema.sql once against this database
# before setting this (`psql "$DATABASE_URL" -f db/schema.sql`).
DATABASE_URL=

# Admin login (see src/lib/admin/). Both required for /admin to work.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
