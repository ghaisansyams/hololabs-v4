# Base URL used for SEO metadata, sitemap, and canonical links.
# Leave unset locally; set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=https://marketing-halomoc.vercel.app

# Shared database. REQUIRED — without it, booking, payment and check-in
# cannot work: there is no other place for one visitor's browser to become
# visible to anyone else, including the admin.
#
# Any plain Postgres server works — a managed one on your own hosting, a
# VPS running Postgres yourself, etc. This is a connection string, not a
# public/anon key — it is only ever read server-side (Server Components /
# Server Actions, see src/lib/db/client.ts), never shipped to the browser.
# Run db/schema.sql once against this database before setting this
# (`psql "$DATABASE_URL" -f db/schema.sql`).
#
# Neon also works, as an opt-in: point this at a *.neon.tech host and
# src/lib/db/client.ts automatically switches to Neon's HTTP driver instead
# of a plain wire-protocol connection.
DATABASE_URL=
