# Base URL used for SEO metadata, sitemap, and canonical links.
# Leave unset locally; set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=https://marketing-halomoc.vercel.app

# Shared database (Supabase). REQUIRED — without these, booking, payment and
# check-in cannot work: there is no other place for one visitor's browser to
# become visible to anyone else, including the admin.
#
# The anon key is safe to ship in the browser bundle by design — every table
# has Row Level Security enabled with either a public-read policy (packages,
# sessions) or zero policies (customers, bookings, payments — default deny),
# so this key can only call the specific functions/views defined in
# supabase/schema.sql. Run that file once in the Supabase SQL Editor before
# setting these. There is no service-role key anywhere in this app; the admin
# reviews and confirms QRIS payments directly in the Supabase Table Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
