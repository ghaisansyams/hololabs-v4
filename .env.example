# Base URL used for SEO metadata, sitemap, and canonical links.
# Leave unset locally; set it to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Shared database. REQUIRED — without it, booking, payment and check-in
# cannot work: there is no other place for one visitor's browser to become
# visible to anyone else, including the admin.
#
# A plain Postgres connection string — local Postgres for development, your
# production server for deployment. It is only ever read server-side
# (Server Components / Server Actions, see src/lib/db/client.ts, Drizzle ORM), never
# shipped to the browser. Run db/schema.sql once against this database
# before setting this (`psql "$DATABASE_URL" -f db/schema.sql`).
DATABASE_URL=

# Admin login (see src/lib/admin/). ADMIN_PASSWORD and ADMIN_SESSION_SECRET are
# required for /admin to work. ADMIN_USERNAME is optional (defaults to "admin").
ADMIN_USERNAME=admin@hololabs.com
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Automatic email through Gmail (Google SMTP): "sedang diverifikasi" when the
# guest reports a transfer, and "pembayaran berhasil" with e-ticket + QR when
# an admin confirms it. GMAIL_APP_PASSWORD is a 16-character App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords), NOT the
# normal password. Without both, no email is sent and /admin shows a notice.
# SITE_URL is the public address used for links in the emails (the real domain).
GMAIL_USER=
GMAIL_APP_PASSWORD=
SITE_URL=
